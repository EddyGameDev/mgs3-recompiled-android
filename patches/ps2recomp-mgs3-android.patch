+#if defined(__ANDROID__)
+#include <algorithm>
+#include <cmath>
+
+namespace
+{
+    struct TouchLayout
+    {
+        float w = 0.0f, h = 0.0f, s = 0.0f;
+        float faceCX = 0.0f, faceCY = 0.0f, faceR = 0.0f;
+        float dpadCX = 0.0f, dpadCY = 0.0f, dpadR = 0.0f;
+        float stickCX = 0.0f, stickCY = 0.0f, stickR = 0.0f;
+        float rstickCX = 0.0f, rstickCY = 0.0f, rstickR = 0.0f;
+        float shoulderR = 0.0f;
+    };
+
+    TouchLayout touchLayout()
+    {
+        const float w = static_cast<float>(GetScreenWidth());
+        const float h = static_cast<float>(GetScreenHeight());
+        const float s = std::min(w, h);
+        TouchLayout l;
+        l.w = w;
+        l.h = h;
+        l.s = s;
+        l.faceCX = 0.885f * w; l.faceCY = 0.70f * h; l.faceR = 0.058f * s;
+        l.dpadCX = 0.115f * w; l.dpadCY = 0.38f * h; l.dpadR = 0.085f * s;
+        l.stickCX = 0.115f * w; l.stickCY = 0.76f * h; l.stickR = 0.105f * s;
+        l.rstickCX = 0.645f * w; l.rstickCY = 0.78f * h; l.rstickR = 0.105f * s;
+        l.shoulderR = 0.075f * s;
+        return l;
+    }
+
+    bool touchCircleHit(float x, float y, float cx, float cy, float r)
+    {
+        const float dx = x - cx;
+        const float dy = y - cy;
+        return dx * dx + dy * dy <= r * r;
+    }
+
+    void touchStickAxis(float x, float y, float cx, float cy, float r, float &outX, float &outY)
+    {
+        float nx = (x - cx) / r;
+        float ny = (y - cy) / r;
+        const float len = std::sqrt(nx * nx + ny * ny);
+        if (len > 1.0f)
+        {
+            nx /= len;
+            ny /= len;
+        }
+        outX = nx;
+        outY = ny;
+    }
+
+    uint8_t touchStickByte(float v)
+    {
+        return static_cast<uint8_t>(std::clamp(128.0f + v * 127.0f, 0.0f, 255.0f));
+    }
+
+    // Polls every active touch point against the virtual controller zones.
+    // Returns true when at least one touch produced input; fills btnsOut
+    // (active-low DualShock bitmask) and the 4 analog stick bytes.
+    bool updateTouchOverlay(uint16_t &btnsOut, uint8_t *stickData)
+    {
+        const int touchCount = GetTouchPointCount();
+        if (touchCount <= 0)
+        {
+            return false;
+        }
+
+        const TouchLayout l = touchLayout();
+        if (l.w <= 0.0f || l.h <= 0.0f)
+        {
+            return false;
+        }
+
+        float leftX = 0.0f, leftY = 0.0f;
+        float rightX = 0.0f, rightY = 0.0f;
+        uint16_t pressed = 0;
+        bool anyTouch = false;
+
+        for (int i = 0; i < touchCount; ++i)
+        {
+            const Vector2 p = GetTouchPosition(i);
+            const float x = p.x;
+            const float y = p.y;
+            anyTouch = true;
+
+            if (touchCircleHit(x, y, l.faceCX, l.faceCY - l.faceR * 1.55f, l.faceR))
+                pressed |= PAD_TRIANGLE;
+            else if (touchCircleHit(x, y, l.faceCX, l.faceCY + l.faceR * 1.55f, l.faceR))
+                pressed |= PAD_CROSS;
+            else if (touchCircleHit(x, y, l.faceCX - l.faceR * 1.55f, l.faceCY, l.faceR))
+                pressed |= PAD_SQUARE;
+            else if (touchCircleHit(x, y, l.faceCX + l.faceR * 1.55f, l.faceCY, l.faceR))
+                pressed |= PAD_CIRCLE;
+            else if (touchCircleHit(x, y, l.dpadCX, l.dpadCY - l.dpadR, l.dpadR))
+                pressed |= PAD_UP;
+            else if (touchCircleHit(x, y, l.dpadCX, l.dpadCY + l.dpadR, l.dpadR))
+                pressed |= PAD_DOWN;
+            else if (touchCircleHit(x, y, l.dpadCX - l.dpadR, l.dpadCY, l.dpadR))
+                pressed |= PAD_LEFT;
+            else if (touchCircleHit(x, y, l.dpadCX + l.dpadR, l.dpadCY, l.dpadR))
+                pressed |= PAD_RIGHT;
+            else if (touchCircleHit(x, y, 0.085f * l.w, 0.055f * l.h, l.shoulderR))
+                pressed |= PAD_L1;
+            else if (touchCircleHit(x, y, 0.915f * l.w, 0.055f * l.h, l.shoulderR))
+                pressed |= PAD_R1;
+            else if (touchCircleHit(x, y, 0.085f * l.w, 0.155f * l.h, l.shoulderR))
+                pressed |= PAD_L2;
+            else if (touchCircleHit(x, y, 0.915f * l.w, 0.155f * l.h, l.shoulderR))
+                pressed |= PAD_R2;
+            else if (touchCircleHit(x, y, 0.56f * l.w, 0.94f * l.h, 0.05f * l.s))
+                pressed |= PAD_START;
+            else if (touchCircleHit(x, y, 0.44f * l.w, 0.94f * l.h, 0.05f * l.s))
+                pressed |= PAD_SELECT;
+            else if (touchCircleHit(x, y, l.rstickCX, l.rstickCY, l.rstickR * 1.6f))
+                touchStickAxis(x, y, l.rstickCX, l.rstickCY, l.rstickR, rightX, rightY);
+            else if (touchCircleHit(x, y, l.stickCX, l.stickCY, l.stickR * 1.6f))
+                touchStickAxis(x, y, l.stickCX, l.stickCY, l.stickR, leftX, leftY);
+        }
+
+        if (!anyTouch)
+        {
+            return false;
+        }
+
+        btnsOut &= static_cast<uint16_t>(~pressed);
+        if (leftX != 0.0f || leftY != 0.0f)
+        {
+            stickData[6] = touchStickByte(leftX);
+            stickData[7] = touchStickByte(leftY);
+        }
+        if (rightX != 0.0f || rightY != 0.0f)
+        {
+            stickData[4] = touchStickByte(rightX);
+            stickData[5] = touchStickByte(rightY);
+        }
+        return true;
+    }
+}
+
+// Drawn from the runtime frame loop (ps2_runtime.cpp) before EndDrawing.
+void ps2DrawTouchOverlay()
+{
+    if (IsGamepadAvailable(0))
+    {
+        return; // physical controller connected: keep the screen clean
+    }
+
+    const TouchLayout l = touchLayout();
+    if (l.w <= 0.0f || l.h <= 0.0f)
+    {
+        return;
+    }
+
+    const Color zoneColor = Fade(SKYBLUE, 0.18f);
+    const Color ringColor = Fade(SKYBLUE, 0.40f);
+    const Color textColor = Fade(WHITE, 0.55f);
+    const int fontSize = static_cast<int>(std::max(10.0f, 0.028f * l.s));
+
+    auto drawZone = [&](float cx, float cy, float r, const char *label)
+    {
+        DrawCircleLines(static_cast<int>(cx), static_cast<int>(cy), r, ringColor);
+        DrawCircle(static_cast<int>(cx), static_cast<int>(cy), r * 0.55f, zoneColor);
+        if (label)
+        {
+            const int textWidth = MeasureText(label, fontSize);
+            DrawText(label, static_cast<int>(cx - textWidth * 0.5f), static_cast<int>(cy - fontSize * 0.5f), fontSize, textColor);
+        }
+    };
+
+    drawZone(l.faceCX, l.faceCY - l.faceR * 1.55f, l.faceR, "TRI");
+    drawZone(l.faceCX, l.faceCY + l.faceR * 1.55f, l.faceR, "X");
+    drawZone(l.faceCX - l.faceR * 1.55f, l.faceCY, l.faceR, "[]");
+    drawZone(l.faceCX + l.faceR * 1.55f, l.faceCY, l.faceR, "O");
+    drawZone(l.dpadCX, l.dpadCY - l.dpadR, l.dpadR, "^");
+    drawZone(l.dpadCX, l.dpadCY + l.dpadR, l.dpadR, "v");
+    drawZone(l.dpadCX - l.dpadR, l.dpadCY, l.dpadR, "<");
+    drawZone(l.dpadCX + l.dpadR, l.dpadCY, l.dpadR, ">");
+    drawZone(l.stickCX, l.stickCY, l.stickR, "L");
+    drawZone(l.rstickCX, l.rstickCY, l.rstickR, "R");
+    drawZone(0.085f * l.w, 0.055f * l.h, l.shoulderR, "L1");
+    drawZone(0.915f * l.w, 0.055f * l.h, l.shoulderR, "R1");
+    drawZone(0.085f * l.w, 0.155f * l.h, l.shoulderR, "L2");
+    drawZone(0.915f * l.w, 0.155f * l.h, l.shoulderR, "R2");
+    drawZone(0.56f * l.w, 0.94f * l.h, 0.05f * l.s, "START");
+    drawZone(0.44f * l.w, 0.94f * l.h, 0.05f * l.s, "SELECT");
+}
